# ─────────────────────────────────────────────────────────────────────────────
# Focus Realm Workspace — environment
# Copy to .env (local) or set in your host's dashboard (Vercel → Settings →
# Environment Variables). Everything here is server-only: never prefix with
# NEXT_PUBLIC_. On Vercel, changes apply to the next deployment — redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────────────
# Connected a database in Vercel → Storage (Neon or Supabase)? Set nothing
# here: the names those integrations inject are read automatically —
#   runtime:    DATABASE_URL → POSTGRES_URL → POSTGRES_PRISMA_URL   (pooled)
#   migrations: DIRECT_URL → DATABASE_URL_UNPOOLED → POSTGRES_URL_NON_POOLING → DATABASE_URL
# Leave the custom prefix empty when connecting the store, or the names won't match.
#
# Anywhere else: DATABASE_URL is the pooled string (Supabase "Transaction pooler",
# port 6543; Neon "-pooler" host) and DIRECT_URL the direct one for migrations
# (Supabase "Session pooler", port 5432 — the db.<ref>.supabase.co host is IPv6-only).
DATABASE_URL="postgresql://focusrealm:focusrealm@localhost:5432/focusrealm_ems"
# DIRECT_URL="postgresql://…direct…"

# Supabase certificates chain to Supabase's own CA, so connections are encrypted
# without verifying it (libpq's "sslmode=require"). To verify, paste the CA from
# Supabase → Database settings → SSL certificate (PEM; "\n" escapes are fine).
# DATABASE_CA_CERT=""

# Connections per server instance (default 5).
# DATABASE_POOL_MAX="5"

# Vercel production builds apply migrations automatically. Preview builds skip
# them (they usually share the production database) unless this is "true".
# MIGRATE_ON_PREVIEW="false"

# ── First run ────────────────────────────────────────────────────────────────
# Lets a founder create the very first account at /setup. Generate with
# `openssl rand -hex 24` (at least 24 characters). The page switches itself off
# once a founder exists; remove the variable afterwards.
# SETUP_TOKEN=""

# ── App ──────────────────────────────────────────────────────────────────────
# The public address of this app, used in links returned to the HR console.
# On Vercel it defaults to the production domain; set it for a custom domain.
APP_URL="http://localhost:3000"

# Company default time zone, used until a browser reports its own.
# An IANA name like "Asia/Kolkata" — not "IST".
APP_TIMEZONE="Asia/Kolkata"

# Largest document upload, in MB. At most 4 on Vercel (it caps request bodies at 4.5 MB).
# Files live in the database, so keep an eye on a free plan's storage.
MAX_UPLOAD_MB="4"

# Prefix for generated employee IDs (FR-0001, FR-0002 …).
EMPLOYEE_CODE_PREFIX="FR"

# ── Integrations ─────────────────────────────────────────────────────────────
# Shared secret for the HR console → Workspace provisioning webhook.
# Generate: openssl rand -hex 32. Set the same value as
# FOCUS_REALM_WORKSPACE_SECRET in the HR console. Leave empty to keep the
# integration switched off.
HR_WEBHOOK_SECRET=""

# Allow the HR console to create or change FOUNDER accounts (default: refused).
# HR_ALLOW_FOUNDER_PROVISIONING="false"

# Protects /api/cron/deadlines (Vercel Cron sends it automatically as a Bearer token).
# Generate: openssl rand -hex 32
CRON_SECRET=""

# ── Danger ───────────────────────────────────────────────────────────────────
# The demo seed wipes every table. It refuses any database that isn't on this
# machine unless this is set to "wipe <hostname>".
# ALLOW_SEED=""
