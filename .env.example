# ─────────────────────────────────────────────────────────────────────────────
# Focus Realm Workspace — environment
# Copy to .env (local) or set in your host's dashboard (Vercel → Settings →
# Environment Variables). Everything here is server-only: never prefix with
# NEXT_PUBLIC_.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres. On Supabase/Neon use the POOLED string here and the DIRECT string
# below (migrations need a direct connection).
DATABASE_URL="postgresql://focusrealm:focusrealm@localhost:5432/focusrealm_ems"
# DIRECT_URL="postgresql://…direct…"

# The public address of this app. Used in links returned to the HR console.
APP_URL="http://localhost:3000"

# Company default time zone, used until a browser reports its own.
APP_TIMEZONE="Asia/Kolkata"

# Shared secret for the HR console → Workspace provisioning webhook.
# Generate: openssl rand -hex 32. Set the same value as
# FOCUS_REALM_WORKSPACE_SECRET in the HR console. Leave empty to keep the
# integration switched off.
HR_WEBHOOK_SECRET=""

# Allow the HR console to create FOUNDER accounts (default: refused).
# HR_ALLOW_FOUNDER_PROVISIONING="false"

# Protects /api/cron/deadlines (Vercel Cron sends it automatically as a Bearer token).
# Generate: openssl rand -hex 32
CRON_SECRET=""

# Largest document upload, in MB. Vercel caps request bodies at 4.5 MB.
MAX_UPLOAD_MB="4"

# Prefix for generated employee IDs (FR-0001, FR-0002 …).
EMPLOYEE_CODE_PREFIX="FR"
