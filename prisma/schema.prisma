// Focus Realm Workspace — data model
//
// One Postgres database. Every table is owned by this app except where an
// external system (the HR console) is the source of truth for a field, which
// is called out on that field.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Founders see and manage everything. Managers lead teams. Employees and
/// interns work on what is assigned to them.
enum Role {
  FOUNDER
  MANAGER
  EMPLOYEE
  INTERN
}

/// INACTIVE means the person has left: they cannot sign in, but their history
/// (tasks, updates) is kept and they can be shown greyed out on the org chart.
enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

/// Where an account came from. HR_CONSOLE accounts are kept in sync by the
/// signed provisioning webhook.
enum AccountSource {
  MANUAL
  HR_CONSOLE
  SEED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AttachmentKind {
  LINK
  NOTE
  FILE
}

enum ActivityKind {
  CREATED
  EDITED
  STATUS_CHANGED
  PRIORITY_CHANGED
  DUE_CHANGED
  ASSIGNEES_CHANGED
  COMMENT
  PROGRESS_UPDATE
  UPDATE_REQUESTED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  CHECKLIST_CHANGED
  LEAD_CHANGED
  WORK_SUBMITTED
  WORK_ACCEPTED
  CHANGES_REQUESTED
  /// Other tasks were folded into this one (or this one into another).
  MERGED
}

/// Who leads a task and who follows: one LEAD answers for it, FOLLOWERs work alongside.
enum AssigneeRole {
  LEAD
  FOLLOWER
}

enum SubmissionStatus {
  SUBMITTED
  ACCEPTED
  CHANGES_REQUESTED
}

enum ClearanceRequestStatus {
  PENDING
  APPROVED
  DECLINED
  WITHDRAWN
}

enum NotificationKind {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  UPDATE_REQUESTED
  UPDATE_POSTED
  TASK_COMMENT
  TASK_STATUS
  TASK_COMPLETED
  ANNOUNCEMENT
  SYSTEM
  WORK_SUBMITTED
  WORK_REVIEWED
  CLEARANCE
  /// The once-a-day summary of what is due, shown on the first visit of each day.
  DAILY_BRIEFING
  /// Meetings: invites, calls, requests to meet a founder and their answers.
  MEETING
  /// Someone was recognised: kudos to them, or an award announced to everyone.
  RECOGNITION
}

/// KUDOS: praise from anyone. AWARD: a named award from founders or management, announced company-wide.
enum RecognitionKind {
  KUDOS
  AWARD
}

/// PERSONAL: someone's own Google calendar (founders connect theirs so people
/// can request time with them). TEAM: the one shared company calendar.
enum GoogleConnectionKind {
  PERSONAL
  TEAM
}

/// Why a work report was filed.
enum WorkReportReason {
  LAST_DAY
  OFFBOARDED
  MANUAL
}

enum CallAnswer {
  JOINED
  DECLINED
}

enum MeetingStatus {
  /// Asked of a founder; not on any calendar until they accept.
  REQUESTED
  SCHEDULED
  DECLINED
  CANCELLED
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  /// A key from the UI palette (blue, sky, indigo, violet, teal, emerald, amber, rose, slate).
  color       String   @default("blue")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  members     User[]
}

model User {
  id                 String           @id @default(cuid())
  /// The login ID, e.g. FR-0042. Stored upper-case. The only way to sign in.
  employeeCode       String           @unique
  /// Stored lower-case. NOT unique: several people can share one mailbox, so
  /// it is never used to sign in or to match HR records.
  email              String
  /// Set when a founder or the person's manager changed the email in the
  /// Workspace. While set, HR console updates leave the email alone.
  emailSetManuallyAt DateTime?
  /// Where Google Calendar invites go, if not their work email — e.g. a
  /// founder's personal Gmail. Set automatically when they connect Google.
  calendarEmail      String?
  /// Founders: what people should know before meeting them ("join 2 minutes early",
  /// "camera on"…). Shown when scheduling with them and added to their invites.
  meetingNotes       String?          @db.Text
  taskSeries         TaskSeries[]     @relation("TaskSeriesCreator")
  /// Last working day (e.g. the end of an internship). The work report is filed that day.
  lastDay            DateTime?
  firstName          String
  lastName           String
  title              String?
  role               Role             @default(EMPLOYEE)
  status             EmploymentStatus @default(ACTIVE)

  /// Granular grants for management. Founders implicitly have all of them.
  canAssignTasks  Boolean @default(false)
  canManageOrg    Boolean @default(false)
  canManagePeople Boolean @default(false)

  phone          String?
  location       String?
  bio            String?
  /// What the person says they are focused on right now. Self-reported, optional.
  focus          String?
  focusUpdatedAt DateTime?
  /// Hue (0–360) used for the initials avatar.
  avatarHue      Int       @default(212)
  joinedAt       DateTime?

  passwordHash        String
  mustChangePassword  Boolean   @default(true)
  /// New people must add a phone number and location before using the Workspace.
  mustCompleteProfile Boolean   @default(true)
  passwordChangedAt   DateTime?
  failedLoginCount    Int       @default(0)
  lockedUntil         DateTime?

  source     AccountSource @default(MANUAL)
  /// The record id in the HR console. Set only for HR-provisioned accounts.
  externalId String?       @unique

  /// The main manager: places the person on the org chart tree.
  managerId          String?
  manager            User?               @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports            User[]              @relation("ReportingLine")
  /// Anyone else this person also reports to (a second boss).
  additionalManagers AdditionalManager[] @relation("AdditionalManagerReport")
  additionalReports  AdditionalManager[] @relation("AdditionalManagerBoss")

  googleConnection     GoogleConnection?     @relation("GoogleConnectionOwner")
  googleConnected      GoogleConnection[]    @relation("GoogleConnectionConnector")
  meetingsOrganised    Meeting[]             @relation("MeetingOrganizer")
  meetingsHosted       Meeting[]             @relation("MeetingHost")
  meetingInvites       MeetingAttendee[]
  workReports          WorkReport[]          @relation("WorkReportSubject")
  recognitionsReceived Recognition[]         @relation("RecognitionRecipient")
  recognitionsGiven    Recognition[]         @relation("RecognitionGiver")
  recognitionCheers    RecognitionCheer[]
  availabilityAsked    AvailabilityRequest[] @relation("AvailabilityRequester")
  availabilityAskedOf  AvailabilityRequest[] @relation("AvailabilityFounder")
  /// Order among siblings on the org chart.
  orgOrder             Int                   @default(0)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions           Session[]
  pushSubscriptions  PushSubscription[]
  tasksCreated       Task[]             @relation("TaskCreator")
  assignments        TaskAssignee[]
  activities         TaskActivity[]
  attachments        Attachment[]
  updateRequestsMade UpdateRequest[]    @relation("UpdateRequester")
  notifications      Notification[]     @relation("NotificationRecipient")
  notificationsSent  Notification[]     @relation("NotificationActor")
  announcements      Announcement[]
  auditEntries       AuditLog[]

  submissions        Submission[]       @relation("SubmissionAuthor")
  reviewsGiven       Submission[]       @relation("SubmissionReviewer")
  clearancesHeld     Clearance[]        @relation("ClearanceViewer")
  clearancesOnMe     Clearance[]        @relation("ClearanceSubject")
  clearancesGranted  Clearance[]        @relation("ClearanceGrantor")
  clearanceRequests  ClearanceRequest[] @relation("ClearanceRequester")
  clearanceAsks      ClearanceRequest[] @relation("ClearanceRequestSubject")
  clearanceDecisions ClearanceRequest[] @relation("ClearanceDecider")

  @@index([managerId])
  @@index([departmentId])
  @@index([status])
  @@index([email])
}

model Session {
  id                String             @id @default(cuid())
  /// SHA-256 of the cookie token. The raw token is never stored.
  tokenHash         String             @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  createdAt         DateTime           @default(now())
  /// Coarse device label ("Chrome on macOS") so people can recognise their own sessions.
  device            String?
  /// "Keep me signed in": phone notifications carry on for a while after it expires.
  remember          Boolean            @default(false)
  /// Phones and browsers that turned on notifications while signed in here.
  pushSubscriptions PushSubscription[]

  @@index([userId])
  @@index([expiresAt])
}

/// A phone or browser that gets notifications even when the Workspace isn't
/// open (Web Push: Android, and iPhone/iPad once added to the home screen).
/// Tied to the session it was turned on in, so signing out stops them.
model PushSubscription {
  id         String   @id @default(cuid())
  /// The push service URL (FCM, Apple, Mozilla …). Identifies the device.
  endpoint   String   @unique
  p256dh     String
  auth       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "Chrome on Android", "Safari on iOS" … shown in Settings.
  device     String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Secrets the app generates for itself (e.g. the Web Push signing key), so
/// features work without extra setup. Values are encrypted at rest.
model AppSecret {
  name      String   @id
  value     String   @db.Text
  createdAt DateTime @default(now())
}

model Task {
  id           String       @id @default(cuid())
  /// Human-friendly sequence number, shown as T-123.
  number       Int          @unique @default(autoincrement())
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  /// The deadline: a date AND a time, stored in UTC.
  dueAt        DateTime
  /// 0–100, set by assignees when they post a progress update.
  progress     Int          @default(0)
  completedAt  DateTime?
  archivedAt   DateTime?
  /// Set when this task was merged into another: its page sends people there.
  mergedIntoId String?
  mergedInto   Task?        @relation("TaskMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   Task[]       @relation("TaskMerge")

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignees      TaskAssignee[]
  attachments    Attachment[]
  activities     TaskActivity[]
  updateRequests UpdateRequest[]
  checklist      ChecklistItem[]
  notifications  Notification[]

  submissions Submission[]

  /// Set when this task is one occurrence of a repeating task.
  seriesId    String?
  series      TaskSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  /// 1-based: "3 of 30".
  seriesIndex Int?

  @@index([dueAt])
  @@index([status])
  @@index([createdById])
  @@index([seriesId])
}

enum RepeatFrequency {
  DAILY
  WEEKDAYS
  WEEKLY
}

/// A founder's repeating task ("Post on LinkedIn", every day for 30 days). Each
/// occurrence becomes an ordinary task shortly before it's due, so assignees see
/// one at a time rather than 30 at once.
model TaskSeries {
  id          String          @id @default(cuid())
  createdById String
  createdBy   User            @relation("TaskSeriesCreator", fields: [createdById], references: [id], onDelete: Restrict)
  title       String
  description String?         @db.Text
  priority    TaskPriority    @default(MEDIUM)
  assigneeIds String[]
  leadId      String
  checklist   String[]
  /// Links and notes copied onto every occurrence: [{ kind, title, url?, content? }].
  attachments Json?
  frequency   RepeatFrequency
  /// How many occurrences in all.
  total       Int
  /// How many have been created so far.
  created     Int             @default(0)
  /// Due date of the next occurrence to create; null once all are created or the series is stopped.
  nextDueAt   DateTime?
  /// The time zone the due time is kept in (e.g. 6 PM in Asia/Kolkata every day).
  timeZone    String
  stoppedAt   DateTime?
  createdAt   DateTime        @default(now())
  tasks       Task[]

  @@index([nextDueAt])
}

model TaskAssignee {
  taskId     String
  userId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  role AssigneeRole @default(FOLLOWER)

  @@id([taskId, userId])
  @@index([userId])
}

model ChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Attachment {
  id          String         @id @default(cuid())
  taskId      String
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind        AttachmentKind
  title       String
  /// LINK: the http(s) URL.
  url         String?
  /// NOTE: the text body.
  content     String?        @db.Text
  /// FILE: metadata. Bytes live in FileBlob so listing attachments never loads them.
  fileName    String?
  mimeType    String?
  size        Int?
  blobId      String?        @unique
  blob        FileBlob?      @relation(fields: [blobId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt   DateTime       @default(now())

  /// Set when the attachment is proof inside a work submission rather than task material.
  submissionId String?
  submission   Submission? @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([submissionId])
}

/// An uploaded file. Stored in Cloudflare R2 when it's set up (storageKey), or
/// in Postgres (data) otherwise — see src/lib/storage.ts.
model FileBlob {
  id         String      @id @default(cuid())
  data       Bytes?
  /// Object key in the R2 bucket.
  storageKey String?     @unique
  createdAt  DateTime    @default(now())
  attachment Attachment?
}

model TaskActivity {
  id        String       @id @default(cuid())
  taskId    String
  task      Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  kind      ActivityKind
  body      String?      @db.Text
  /// Structured detail, e.g. { from: "TODO", to: "IN_PROGRESS" } or { progress: 60 }.
  meta      Json?
  createdAt DateTime     @default(now())

  @@index([taskId, createdAt])
  @@index([actorId])
}

/// A founder or manager asking the assignees "where is this at?".
/// Resolved automatically when an assignee posts a progress update.
model UpdateRequest {
  id            String    @id @default(cuid())
  taskId        String
  task          Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User      @relation("UpdateRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  message       String?
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([taskId, resolvedAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  /// Makes system-generated alerts (deadline reminders) idempotent.
  dedupeKey String?

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String   @db.Text
  pinned    Boolean  @default(false)
  /// Optional PDF shared with the announcement (e.g. a guide or policy).
  pdf       Bytes?
  /// The PDF's object key in R2, when stored there instead of in `pdf`.
  pdfKey    String?
  pdfName   String?
  pdfSize   Int?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pinned, createdAt])
}

/// Every call the HR console makes, minus any credentials. Lets founders see
/// that the integration is healthy and makes webhook delivery idempotent.
model IntegrationEvent {
  id        String   @id @default(cuid())
  source    String
  /// The sender's event id. Unique, so a retried delivery is never applied twice.
  eventId   String   @unique
  type      String
  status    String
  error     String?
  summary   Json?
  userId    String?
  createdAt DateTime @default(now())
  /// When the status last changed — tells a crashed, half-applied delivery from one still in flight.
  updatedAt DateTime @default(now()) @updatedAt

  @@index([source, createdAt])
}

/// Administrative changes to accounts and the organisation (who changed a
/// role, reset a password, moved someone on the org chart). Not activity
/// tracking: nothing about how employees spend their time is recorded.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  targetType String
  targetId   String?
  summary    String
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

/// Work handed in for review. Never empty: a write-up, a document or a link proves the work was done.
model Submission {
  id            String           @id @default(cuid())
  taskId        String
  task          Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User             @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)
  /// The written account of what was done.
  summary       String?          @db.Text
  status        SubmissionStatus @default(SUBMITTED)
  reviewedById  String?
  reviewedBy    User?            @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  reviewNote    String?          @db.Text
  createdAt     DateTime         @default(now())
  attachments   Attachment[]

  @@index([taskId, createdAt])
}

/// Permission for one person to see another's work. Only founders grant it, and
/// never over a founder: founders' work is visible to founders alone.
model Clearance {
  id          String            @id @default(cuid())
  viewerId    String
  viewer      User              @relation("ClearanceViewer", fields: [viewerId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     User              @relation("ClearanceSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  grantedById String
  grantedBy   User              @relation("ClearanceGrantor", fields: [grantedById], references: [id], onDelete: Restrict)
  note        String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  revokedById String?
  createdAt   DateTime          @default(now())
  request     ClearanceRequest?

  @@index([viewerId, revokedAt])
  @@index([subjectId, revokedAt])
}

/// Someone asking to see a colleague's work. Needs the colleague's consent and a founder's approval.
model ClearanceRequest {
  id                String                 @id @default(cuid())
  requesterId       String
  requester         User                   @relation("ClearanceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  subjectId         String
  subject           User                   @relation("ClearanceRequestSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  reason            String                 @db.Text
  status            ClearanceRequestStatus @default(PENDING)
  /// The colleague's answer; null until they respond.
  subjectConsent    Boolean?
  subjectAnsweredAt DateTime?
  /// A founder's decision; null until one decides.
  founderApproved   Boolean?
  decidedById       String?
  decidedBy         User?                  @relation("ClearanceDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt         DateTime?
  clearanceId       String?                @unique
  clearance         Clearance?             @relation(fields: [clearanceId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([subjectId, status])
  @@index([requesterId, status])
  @@index([status])
}

/// A second (or third) person someone reports to, alongside their main manager.
/// Both are their bosses; only the main manager places them on the org chart tree.
model AdditionalManager {
  userId    String
  user      User     @relation("AdditionalManagerReport", fields: [userId], references: [id], onDelete: Cascade)
  managerId String
  manager   User     @relation("AdditionalManagerBoss", fields: [managerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, managerId])
  @@index([managerId])
}

/// A Google account connected through OAuth. Tokens are encrypted at rest
/// (AES-256-GCM, src/lib/google/crypto.ts) and never sent to the browser.
model GoogleConnection {
  id                   String               @id @default(cuid())
  kind                 GoogleConnectionKind
  /// PERSONAL: whose calendar this is. TEAM: null.
  userId               String?              @unique
  user                 User?                @relation("GoogleConnectionOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// "team" for the TEAM connection, so there can only ever be one.
  teamKey              String?              @unique
  connectedById        String
  connectedBy          User                 @relation("GoogleConnectionConnector", fields: [connectedById], references: [id], onDelete: Cascade)
  googleEmail          String
  /// The calendar events go on: "primary" for a personal one, the shared team calendar's id for TEAM.
  calendarId           String               @default("primary")
  calendarName         String?
  refreshToken         String
  accessToken          String?
  accessTokenExpiresAt DateTime?
  /// Set when Google refuses the stored token: someone has to connect again.
  lastError            String?
  /// What the account allowed when it connected (space-separated). Without the Meet
  /// settings permission, Meet links can't be made open to anyone with the link.
  scopes               String?
  /// Why the last attempt to open a Meet link failed (e.g. the Meet API isn't turned on).
  meetError            String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

/// A meeting arranged through the Workspace. Lives on Google Calendar (with a
/// Google Meet link) once scheduled; a request to a founder lives here only
/// until they answer.
model Meeting {
  id               String                @id @default(cuid())
  title            String
  description      String?               @db.Text
  startAt          DateTime
  endAt            DateTime
  status           MeetingStatus         @default(SCHEDULED)
  /// "Meet now": an instant call rather than a scheduled meeting.
  instant          Boolean               @default(false)
  organizerId      String
  organizer        User                  @relation("MeetingOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  /// For a request: the founder being asked. They decide, and it goes on their calendar.
  hostId           String?
  host             User?                 @relation("MeetingHost", fields: [hostId], references: [id], onDelete: SetNull)
  /// The founder's answer when declining.
  responseNote     String?
  respondedAt      DateTime?
  /// Which calendar it went on, and the Google event.
  calendarKind     GoogleConnectionKind?
  googleCalendarId String?
  googleEventId    String?
  /// Copy of a founder meeting on the shared team calendar (the real event lives on the founder's own calendar).
  teamEventId      String?
  htmlLink         String?
  meetUrl          String?
  /// A block split into back-to-back slots (e.g. 4 × 15-min interviews), each with its own Meet link.
  slots            MeetingSlot[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  attendees        MeetingAttendee[]

  @@index([organizerId, startAt])
  @@index([hostId, status])
  @@index([startAt])
}

/// One slot of a multi-slot founder meeting: its own calendar event and Meet link,
/// usually for one external guest (e.g. an interview candidate).
model MeetingSlot {
  id            String   @id @default(cuid())
  meetingId     String
  meeting       Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  position      Int
  startAt       DateTime
  endAt         DateTime
  /// Who the slot is for, e.g. the candidate's name. Used in the copyable invite.
  guestName     String?
  googleEventId String?
  meetUrl       String?
  htmlLink      String?

  @@unique([meetingId, position])
}

model MeetingAttendee {
  meetingId  String
  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "Meet now": how they answered the ringing call, on any device. Stops it ringing everywhere else.
  callAnswer CallAnswer?
  answeredAt DateTime?

  @@id([meetingId, userId])
  @@index([userId])
}

/// A saved copy of someone's work report — filed on their last day, when they're
/// offboarded, or by a founder. The live report is always computed fresh; this
/// keeps exactly what it said at the time.
model WorkReport {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation("WorkReportSubject", fields: [userId], references: [id], onDelete: Cascade)
  reason        WorkReportReason
  generatedById String?
  data          Json
  createdAt     DateTime         @default(now())

  @@index([userId, createdAt])
}

/// Praise or an award for someone, shown on the company-wide recognition wall.
model Recognition {
  id          String             @id @default(cuid())
  kind        RecognitionKind    @default(KUDOS)
  /// A key from src/lib/recognition.ts (star, teamwork, above, …).
  badge       String
  /// The award's name, e.g. "Intern of the Month". Awards only.
  title       String?
  message     String             @db.Text
  recipientId String
  recipient   User               @relation("RecognitionRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  giverId     String
  giver       User               @relation("RecognitionGiver", fields: [giverId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  cheers      RecognitionCheer[]

  @@index([createdAt])
  @@index([recipientId, createdAt])
}

/// A colleague adding their applause to a recognition.
model RecognitionCheer {
  recognitionId String
  recognition   Recognition @relation(fields: [recognitionId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@id([recognitionId, userId])
}

enum AvailabilityRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// Someone asking a founder to see when they're free, saying why and how much time
/// they need. Founders' free time stays private until they approve.
model AvailabilityRequest {
  id          String                    @id @default(cuid())
  requesterId String
  requester   User                      @relation("AvailabilityRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  founderId   String
  founder     User                      @relation("AvailabilityFounder", fields: [founderId], references: [id], onDelete: Cascade)
  purpose     String                    @db.Text
  /// How many meetings they want, and how long each.
  meetings    Int
  slotMinutes Int
  status      AvailabilityRequestStatus @default(PENDING)
  note        String?
  decidedAt   DateTime?
  /// An approval lets them see open slots until then.
  expiresAt   DateTime?
  createdAt   DateTime                  @default(now())

  @@index([founderId, status])
  @@index([requesterId, founderId])
}
